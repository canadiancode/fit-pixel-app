# Copy to `.env` and fill in values. Never commit `.env`.
#
# Fit Pixel API (food search proxy, auth/sync)
# Default in code is https://api.aurashields.com if unset.
EXPO_PUBLIC_FIT_PIXEL_API_URL=https://api.aurashields.com

# Supabase Auth (anon key only). Never add a service-role key.
# Never prefix a service-role secret with EXPO_PUBLIC_.
# Fit Pixel project: https://gteamfeljxlpsnaruexq.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Maps — required for Android Google Maps (native key is baked in at prebuild).
# Enable Maps SDK for Android (and iOS if you use Google Maps there) on one key.
# After setting this, rebuild Android: `npm run android` or `npm run android:device`.
# Also push it to EAS so cloud builds get the key:
#   npx eas env:push development --path .env --force
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
