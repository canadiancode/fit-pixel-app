# Copy to `.env` and fill in values. Never commit `.env`.
#
# Fit Pixel API (food search proxy, auth/sync)
# Default in code is https://api.fitpixel.app if unset.
EXPO_PUBLIC_FIT_PIXEL_API_URL=https://api.fitpixel.app

# Supabase Auth (anon key only). Never add a service-role key.
# Never prefix a service-role secret with EXPO_PUBLIC_.
# Fit Pixel project: https://gteamfeljxlpsnaruexq.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Maps — required for Android Google Maps (native key is baked in at prebuild).
# Enable Maps SDK for Android (and iOS if you use Google Maps there) on one key.
# After setting this, rebuild Android: `npm run android` or `npm run android:device`.
# Also push it to EAS so cloud builds get the key:
#   npx eas env:push development --path .env --force
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Dev-only sample friends, DMs, requests and gym chatter in the Chat tab (in-memory,
# never written to the server). Ignored in release builds. Set to 1 to enable.
EXPO_PUBLIC_CHAT_DEMO=

# Crash reporting (Sentry). The project DSN is built in (lib/crash-reporting.ts);
# set this only to override it. Always off in development.
# To upload source maps for readable stack traces, also add SENTRY_ORG,
# SENTRY_PROJECT and a secret SENTRY_AUTH_TOKEN to EAS, then drop
# SENTRY_DISABLE_AUTO_UPLOAD from eas.json.
EXPO_PUBLIC_SENTRY_DSN=
