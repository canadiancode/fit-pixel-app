{
  "cli": {
    "version": ">= 21.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_FIT_PIXEL_API_URL": "https://api.aurashields.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_FIT_PIXEL_API_URL": "https://api.aurashields.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_FIT_PIXEL_API_URL": "https://api.aurashields.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
