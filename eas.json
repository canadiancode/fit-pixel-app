{
  "cli": {
    "version": ">= 21.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_FIT_PIXEL_API_URL": "https://api.aurashields.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_FIT_PIXEL_API_URL": "https://api.aurashields.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_FIT_PIXEL_API_URL": "https://api.aurashields.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "ascAppId": "6795745418"
      }
    }
  }
}
